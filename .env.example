# Copy to .env.local and fill in from Supabase: Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: order confirmation emails via EmailJS (emailjs.com).
# Without these, checkout still works, it just skips sending email.
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_CUSTOMER=your-customer-template-id
VITE_EMAILJS_TEMPLATE_ADMIN=your-admin-template-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key
